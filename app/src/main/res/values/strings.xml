    <string name="wizard_s3_wifi_pwd_label">Wi-Fi Password (leave blank if none)</string>
    <string name="wizard_s3_wifi_hint">💡 Recommendation: Ensure Wi-Fi supports the 2.4GHz band to guarantee compatibility with older phones.</string>
    <string name="wizard_s3_ts_title">Tailscale Auth Key Configuration</string>
    <string name="wizard_s3_ts_prompt">Supports entering Auth Key (tskey-auth-...) or API Key (tskey-api-...):</string>
    <string name="wizard_s3_ts_btn_web">Get Key from Tailscale (Opens Browser)</string>
    <string name="wizard_s3_ts_key_label">Paste Auth Key or API Key</string>
    <string name="wizard_s3_ts_key_placeholder">tskey-auth-... or tskey-api-...</string>
    <string name="wizard_s3_ts_key_hide">Hide Key</string>
