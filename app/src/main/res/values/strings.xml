    <string name="wizard_s1_header">Upgrade to Dedicated Device</string>
    <string name="wizard_s1_desc">By enabling Android\'s official Device Owner mode, Dedicated Device Mode delivers maximum monitoring reliability, ensuring your camera operates uninterrupted 24/7, auto-starts on boot, and is never disrupted by sleep modes or other app notifications.</string>
    <string name="wizard_s1_warn_icon">Warning</string>
    <string name="wizard_s1_warn_title">Please prepare a spare/old phone you no longer use!</string>
    <string name="wizard_s1_warn_body">The upcoming steps require performing a Factory Reset on that phone, which will erase all photos, accounts, and personal data on it. Make sure NEVER to use your primary daily phone!</string>
    <string name="wizard_s1_chk_erase">I understand this will erase the old phone\'s data</string>
    <string name="wizard_s1_btn_next">I\'ve prepared the old phone, Next</string>
    <string name="wizard_s2_header">Step 1: Reset Your Old Phone</string>
    <string name="wizard_s2_step1">Pick up your old phone (the one to be used as a camera).</string>
    <string name="wizard_s2_step2">Go to Settings &gt; System &gt; Reset options on the old phone.</string>
    <string name="wizard_s2_step3">Select \"Erase all data (factory reset)\" and wait for the phone to restart.</string>
    <string name="wizard_s2_step4">When the old phone displays the \"Hello\" or \"Welcome\" initial setup screen, stop right there!</string>
    <string name="wizard_s2_btn_next">Old phone is on Welcome screen, Next</string>
    <string name="wizard_s3_header">Step 2: Configure Connection Parameters</string>
    <string name="wizard_s3_wifi_title">Old Phone Wi-Fi Settings</string>
    <string name="wizard_s3_wifi_btn_autofill">📥 Auto-fill Current Wi-Fi</string>
